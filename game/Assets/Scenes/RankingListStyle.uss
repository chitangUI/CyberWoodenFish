.ranking-screen {
    width: 100%;
    height: 100%;
    
    flex-grow: 1;
    align-items: center;
    flex-direction: column;
    background-color: rgb(42, 52, 67);
}

.title {
    height: 50px;

    margin: 32px 0 16px 0;
    padding: 16px;
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

.ranking-list {
    flex-direction: column;
    flex-grow: 1;
}

.ranking-item {
    justify-content: space-between;
    align-items: center;

    padding: 8px;

    margin-bottom: 8px;

    background-color: rgb(70, 85, 105);
    border-radius: 12px;
}

.player-name {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
}

.player-combo {
    font-size: 14px;
    color: white;
}
